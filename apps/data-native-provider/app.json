{
  "id": "data-native-provider",
  "title": "Data Provider",
  "description": "Autostart read-only BMW TASU vehicle source for BMRMODZ Data Tool",
  "version": "0.1.2",
  "vendor": "custom",
  "loggingId": "DNP1",
  "iconGlyph": "temp",
  "mguAppStartType": "autostart",
  "config": {
    "customSettings": false
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Data Provider",
      "bar": false
    }
  ],
  "settings": [],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_optional": "Automatic iDrive language",
      "_instances": "HMI_CID",
      "currentDisplayLanguage": "rs"
    }
  },
  "requires": {
    "bmrmodz-data-tool": "0.1.72",
    "idrive7-renderd": "2.1.19",
    "mgu-inputgate": "1.2.1"
  },
  "mguInternet": false
}
