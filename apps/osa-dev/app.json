{
  "id": "osa-dev",
  "title": "Oil Service Assistant DEV",
  "description": "Engine, coolant and transmission oil temperature monitoring with live warm-up estimates and locally stored service history",
  "version": "0.2.71",
  "config": {
    "customSettings": true,
    "previewEquipment": [
      {
        "key": "previewNoticeScenario",
        "label": "Pop-up scenario",
        "hidden": true,
        "type": "choice",
        "default": "first",
        "options": [
          ["first", "First install"],
          ["ordinary", "Routine update"],
          ["one", "One important notice"],
          ["multiple", "Skipped versions"]
        ]
      }
    ]
  },
  "settingsBeforeLast": true,
  "settingsTabInStandard": false,
  "vendor": "custom",
  "loggingId": "OSAD",
  "iconGlyph": "temp",
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Oil Service Assistant DEV",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_PREV",
          "Previous page"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "en",
          "English"
        ],
        [
          "de",
          "Deutsch"
        ],
        [
          "es",
          "Español"
        ],
        [
          "fr",
          "Français"
        ],
        [
          "hu",
          "Magyar"
        ],
        [
          "pl",
          "Polski"
        ],
        [
          "sk",
          "Slovenčina"
        ],
        [
          "cs",
          "Čeština"
        ],
        [
          "it",
          "Italiano"
        ],
        [
          "ru",
          "Русский"
        ],
        [
          "da",
          "Dansk"
        ],
        [
          "el",
          "Ελληνικά"
        ],
        [
          "zh-CN",
          "简体中文"
        ],
        [
          "nl",
          "Nederlands"
        ],
        [
          "nb",
          "Norsk"
        ],
        [
          "pt",
          "Português"
        ],
        [
          "ro",
          "Română"
        ],
        [
          "sl",
          "Slovenščina"
        ],
        [
          "fi",
          "Suomi"
        ],
        [
          "sv",
          "Svenska"
        ],
        [
          "tr",
          "Türkçe"
        ],
        [
          "uk",
          "Українська"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "cluster6wbAvailable",
      "label": "6WB or 6U3 cluster detected",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "oilCluster",
      "label": "Notification on cluster",
      "type": "bool",
      "default": false,
      "notification": true,
      "when": {
        "cluster6wbAvailable": true
      }
    },
    {
      "key": "clusterBcTest",
      "label": "Show notification message",
      "actionLabel": "Run",
      "type": "action"
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "hidden": true,
      "reset": 1,
      "options": [["auto", "Auto"], ["on", "On"]]
    },
    {
      "key": "warmOil",
      "label": "Oil is warm at",
      "type": "number",
      "unit": "°C",
      "default": 80,
      "steps": [
        60,
        70,
        75,
        80,
        85,
        90,
        100
      ]
    },
    {
      "key": "warmCoolant",
      "label": "Coolant is warm at",
      "type": "number",
      "unit": "°C",
      "default": 80,
      "steps": [
        60,
        70,
        75,
        80,
        85,
        90
      ]
    },
    {
      "key": "reloadEquipment",
      "label": "Reload Equipment",
      "actionLabel": "Reload",
      "type": "action",
      "hint": "Read vehicle equipment again"
    }
  ],
  "signals": {
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_optional": "Automatic iDrive language",
      "_instances": "HMI_CID",
      "currentDisplayLanguage": "rs"
    }
  },
  "requires": {
    "idrive7-renderd": "2.1.19",
    "mgu-inputgate": "1.2.1",
    "bmrmodz-car-equipment": "0.1.5",
    "bmrmodz-notification": "0.2.1",
    "bmrmodz-data-tool": "0.1.60",
    "bmrmodz-background-tool": "0.1.4"
  }
}
