{
  "id": "data-diagnostics",
  "title": "Data Tool Diagnostics",
  "description": "Experimental read-only feasibility diagnostics for the BMRMODZ Data Tool",
  "version": "0.2.7",
  "vendor": "custom",
  "loggingId": "DAT1",
  "iconGlyph": "temp",
  "config": {
    "customSettings": false
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Data Tool Diagnostics",
      "buttons": []
    }
  ],
  "settings": [
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "default": "en",
      "options": [
        [
          "en",
          "English"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "m_red",
          "M Red"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.climate.Climate": {
      "_optional": "Read-only rule candidate",
      "operationAutomaticSwitchDriverSeat": "s"
    },
    "de.bmw.infotainment.climate.climatemaster.ClimateMaster": {
      "_optional": "Read-only rule candidate",
      "statusClimateUpdateAutomatic": "s"
    }
  },
  "requires": {
    "idrive7-renderd": "2.1.19",
    "mgu-inputgate": "1.2.1"
  },
  "mguInternet": true
}
