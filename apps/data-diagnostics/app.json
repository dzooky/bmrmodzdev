{
  "id": "data-diagnostics",
  "title": "Data Tool Diagnostics",
  "description": "Experimental read-only feasibility diagnostics for the BMRMODZ Data Tool",
  "version": "0.1.81",
  "vendor": "custom",
  "loggingId": "DAT1",
  "iconGlyph": "temp",
  "config": {
    "customSettings": false
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Data Tool Diagnostics",
      "buttons": [
        [
          "BTN_BT",
          "Start / stop BT test"
        ],
        [
          "BTN_NT",
          "Test notification"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "default": "en",
      "options": [
        [
          "en",
          "English"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "m_red",
          "M Red"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    }
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ],
      "_optional": "Read-only native front seat-belt comparison"
    }
  },
  "requires": {
    "idrive7-renderd": "2.1.19",
    "mgu-inputgate": "1.2.1",
    "bmrmodz-data-tool": "0.1.69"
  },
  "mguInternet": true
}
