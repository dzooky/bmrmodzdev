{
  "id": "osa-engine-diagnostics",
  "title": "OSA Engine Diagnostics",
  "description": "Read-only comparison of native BMW CDS and shared Data Tool engine signals",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OED1",
  "iconGlyph": "temp",
  "config": {
    "customSettings": false
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "OSA Engine Diagnostics",
      "buttons": [
        [
          "BTN_TEST",
          "Run engine test"
        ],
        [
          "BTN_SEND",
          "Send report"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "default": "en",
      "options": [
        [
          "en",
          "English"
        ],
        [
          "sk",
          "Slovenčina"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    }
  },
  "requires": {
    "idrive7-renderd": "2.1.19",
    "mgu-inputgate": "1.2.1",
    "bmrmodz-data-tool": "0.1.60"
  },
  "mguInternet": true
}
