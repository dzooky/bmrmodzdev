{
  "id": "dpf-dev",
  "title": "DPF Status DEV",
  "description": "Isolated development copy of BMW DPF Status. Not verified for simultaneous operation with stable DPF.",
  "version": "0.1.92",
  "config": {
    "customSettings": true,
    "previewEquipment": [
      {
        "key": "previewWelcome",
        "label": "Pop-up scenario",
        "type": "choice",
        "hidden": true,
        "default": "welcome",
        "options": [
          ["welcome", "First install"],
          ["dashboard", "Dashboard"],
          ["update", "What's New"]
        ]
      }
    ]
  },
  "vendor": "custom",
  "loggingId": "DPFD",
  "iconGlyph": "temp",
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "DPF Status DEV",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ],
        [
          "BTN_NOTICE_OK",
          "OK"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_optional": "Automatic iDrive language",
      "_instances": "HMI_CID",
      "currentDisplayLanguage": "rs"
    }
  },
  "settingsBeforeLast": true,
  "settings": [
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "en",
          "English"
        ],
        [
          "de",
          "Deutsch"
        ],
        [
          "es",
          "Español"
        ],
        [
          "fr",
          "Français"
        ],
        [
          "hu",
          "Magyar"
        ],
        [
          "pl",
          "Polski"
        ],
        [
          "sk",
          "Slovenčina"
        ],
        [
          "cs",
          "Čeština"
        ],
        [
          "it",
          "Italiano"
        ],
        [
          "ru",
          "Русский"
        ],
        [
          "da",
          "Dansk"
        ],
        [
          "el",
          "Ελληνικά"
        ],
        [
          "zh-CN",
          "简体中文"
        ],
        [
          "nl",
          "Nederlands"
        ],
        [
          "nb",
          "Norsk"
        ],
        [
          "pt",
          "Português"
        ],
        [
          "ro",
          "Română"
        ],
        [
          "sl",
          "Slovenščina"
        ],
        [
          "fi",
          "Suomi"
        ],
        [
          "sv",
          "Svenska"
        ],
        [
          "tr",
          "Türkçe"
        ],
        [
          "uk",
          "Українська"
        ]
      ]
    },
    {
      "key": "cluster6wbAvailable",
      "label": "6WB or 6U3 cluster detected",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "regenCluster",
      "label": "DPF notification on cluster",
      "type": "bool",
      "default": true,
      "notification": true,
      "when": {
        "cluster6wbAvailable": true
      }
    },
    {
      "key": "regenClusterTest",
      "label": "Test DPF cluster message",
      "type": "action",
      "hint": "Four alerts: Requested (yellow), Started and In Progress (red), Finished (green)",
      "when": {
        "cluster6wbAvailable": true
      }
    },
    {
      "key": "reloadEquipment",
      "label": "Reload Equipment",
      "actionLabel": "Reload",
      "type": "action",
      "hint": "Read vehicle equipment again"
    }
  ],
  "settingsTabInStandard": false,
  "requires": {
    "idrive7-renderd": "2.1.19",
    "mgu-inputgate": "1.2.1",
    "bmrmodz-car-equipment": "0.1.5",
    "bmrmodz-notification": "0.2.1",
    "bmrmodz-data-tool": "0.1.74",
    "bmrmodz-background-tool": "0.1.5"
  }
}
