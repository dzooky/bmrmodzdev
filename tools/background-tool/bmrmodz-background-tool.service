[Unit]
Description=BMRMODZ Background Tool experimental evaluation service
After=bmrmodz-data-tool.service
[Service]
Type=simple
RuntimeDirectory=bmrmodz-background-tool
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /var/opt/bmrmodz-background-tool/current/service.js
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
