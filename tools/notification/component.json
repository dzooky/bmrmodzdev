{
  "id": "bmrmodz-notification",
  "kind": "tool",
  "version": "0.2.1",
  "title": "Notification Tool",
  "description": "Experimental standalone segmented KOMBI text renderer and bounded notification queue; BC coexistence unverified.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "idrive7-renderd": "2.1.19",
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "service.js",
      "from": "service.js",
      "mode": "0644"
    },
    {
      "path": "text-renderer.js",
      "from": "text-renderer.js",
      "mode": "0644"
    },
    {
      "path": "canvas.js",
      "from": "canvas.js",
      "mode": "0644"
    },
    {
      "path": "fonts.js",
      "from": "fonts.js",
      "mode": "0644"
    },
    {
      "path": "fonts/bold.json",
      "from": "fonts/bold.json",
      "mode": "0644"
    },
    {
      "path": "fonts/label.json",
      "from": "fonts/label.json",
      "mode": "0644"
    },
    {
      "path": "fonts/cjk.json",
      "from": "fonts/cjk.json",
      "mode": "0644"
    },
    {
      "path": "fonts/LICENCE-UbuntuSans.txt",
      "from": "fonts/LICENCE-UbuntuSans.txt",
      "mode": "0644"
    },
    {
      "path": "fonts/OFL-NotoSansSC.txt",
      "from": "fonts/OFL-NotoSansSC.txt",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bmrmodz-notification.service",
      "from": "bmrmodz-notification.service"
    }
  ],
  "enable": [
    {
      "unit": "bmrmodz-notification.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "bmrmodz-notification.service"
  ],
  "recmgr": [
    "bmrmodz-notification"
  ]
}
